    },
    {
      "type": "textarea",
      "id": "reason_two_text",
      "label": "Reason 2 text",
      "default": "Product pages give each scent room to feel premium and considered."
    },
    {
      "type": "text",
      "id": "reason_three_title",
      "label": "Reason 3 title",
      "default": "Bundle friendly"
    },
    {
      "type": "textarea",
      "id": "reason_three_text",
      "label": "Reason 3 text",
      "default": "The layout keeps discovery sets, bundles, and gift shopping easy to scan."
    },
    {
      "type": "text",
      "id": "reason_four_title",
      "label": "Reason 4 title",
      "default": "Elegant gifting"
    },
    {
      "type": "textarea",
      "id": "reason_four_text",
      "label": "Reason 4 text",
      "default": "A polished visual system gives every product a gift-ready presence."
    },
    {
      "type": "text",
