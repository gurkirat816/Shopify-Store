      "label": "Secondary button label",
      "default": "Shop full collection"
    },
    {
      "type": "text",
      "id": "metric_one_label",
      "label": "First metric label",
      "default": "Scents to explore"
    },
    {
      "type": "text",
      "id": "metric_two_value",
      "label": "Second metric value",
      "default": "EDP"
    },
    {
      "type": "text",
      "id": "metric_two_label",
      "label": "Second metric label",
      "default": "Rich concentration"
    },
    {
      "type": "text",
      "id": "metric_three_value",
