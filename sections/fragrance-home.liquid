      "type": "image_picker",
      "id": "cta_image",
      "label": "Custom scent image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Hero eyebrow",
      "default": "Signature parfum collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero heading",
      "default": "Fragrance for every occasion"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Hero text",
      "default": "Find refined scents for daily rituals, evenings, gifting, and everything between."
    },
    {
      "type": "url",
