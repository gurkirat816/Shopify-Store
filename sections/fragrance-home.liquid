    },
    {
      "type": "text",
      "id": "metric_three_label",
      "label": "Third metric label",
      "default": "Ready presentation"
    },
    {
      "type": "text",
      "id": "why_eyebrow",
      "label": "Why eyebrow",
      "default": "Why shop with us"
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Why heading",
      "default": "A refined fragrance store built for discovery."
    },
    {
      "type": "text",
      "id": "reason_one_title",
      "label": "Reason 1 title",
      "default": "Curated edits"
    },
    {
      "type": "textarea",
      "id": "reason_one_text",
      "label": "Reason 1 text",
      "default": "Collections are organized around scent mood, occasion, and daily wear."
    },
    {
      "type": "text",
      "id": "reason_two_title",
      "label": "Reason 2 title",
