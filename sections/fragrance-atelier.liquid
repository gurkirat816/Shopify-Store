{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

{% liquid
  assign cta_image = section.settings.image

  assign cta_link = section.settings.button_link
  if cta_link == blank
    assign cta_link = routes.all_products_collection_url
  endif
%}

<div
  class="fragrance-home fragrance-home--{{ section.settings.section_width | default: 'full-width' }} color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.use_color_scheme %} fragrance-home--use-color-scheme{% endif %} spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --fh-section-width: {% if section.settings.section_width == 'full-width' %}100%{% else %}1180px{% endif %};
    --fh-section-gutter: {% if section.settings.section_width == 'full-width' %}0px{% else %}32px{% endif %};
    --fh-section-bg: {{ section.settings.section_background }};
    --fh-atelier-bg: {{ section.settings.section_background }};
    --fh-atelier-text: {{ section.settings.text_color }};
    --fh-atelier-muted: {{ section.settings.muted_text }};
    --fh-atelier-accent: {{ section.settings.accent_color }};
    --fh-atelier-border: {{ section.settings.border_color }};
    --fh-button-light-bg: {{ section.settings.button_background }};
    --fh-button-light-text: {{ section.settings.button_text }};
    --fh-button-light-border: {{ section.settings.button_border }};
  "
>
  <section class="fragrance-home__atelier">
    <div class="fragrance-home__atelier-media">
      {% if cta_image != blank %}
        <img
          src="{{ cta_image | image_url: width: 1200 }}"
          alt="{{ cta_image.alt | default: section.settings.heading | escape }}"
          width="{{ cta_image.width }}"
          height="{{ cta_image.height }}"
          loading="lazy"
        >
      {% else %}
        <img
          src="{{ 'fragrance-hero-luxury.png' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          width="1749"
          height="899"
          loading="lazy"
        >
      {% endif %}
    </div>
    <div class="fragrance-home__atelier-copy">
      <p class="fragrance-home__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <ol>
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {% endfor %}
      </ol>
      <a class="fragrance-home__button fragrance-home__button--light" href="{{ cta_link }}">
        {{ section.settings.button_label }}
      </a>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Fragrance custom perfume",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "Use Horizon color scheme",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A personal experience"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create a perfume that feels like yours"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Guide shoppers into a more personal fragrance moment with a clear premium callout."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start custom scent"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#20362e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "muted_text",
      "label": "Muted text",
      "default": "#d8d0c4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Step number",
      "default": "#f3d89b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider",
      "default": "#53665d"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Button border",
      "default": "#fffdf8"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Choose a scent direction"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance custom perfume",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "text": "Choose a scent direction"
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Refine notes and intensity"
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Bottle it for daily wear or gifting"
          }
        }
      ]
    }
  ]
}
{% endschema %}
