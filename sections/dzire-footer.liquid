{{ 'dzire-theme.css' | asset_url | stylesheet_tag }}

<div
  class="dzire-shell"
  style="
    --dz-footer-bg: {{ section.settings.footer_background }};
    --dz-footer-text: {{ section.settings.footer_text }};
    --dz-footer-muted: {{ section.settings.footer_muted_text }};
    --dz-footer-accent: {{ section.settings.footer_accent }};
    --dz-footer-border: {{ section.settings.footer_border }};
    --dz-footer-input-bg: {{ section.settings.input_background }};
    --dz-footer-input-text: {{ section.settings.input_text }};
    --dz-footer-button-bg: {{ section.settings.button_background }};
    --dz-footer-button-text: {{ section.settings.button_text }};
  "
>
  <footer class="dzire-footer">
    <div class="dzire-footer__inner">
      <div class="dzire-footer__brand">
        <div>
          <h2>{{ section.settings.heading }}</h2>
          <p>{{ section.settings.text }}</p>
        </div>

        {% if section.settings.image != blank or section.settings.show_default_image %}
          <div class="dzire-footer__media" aria-hidden="true">
            {% if section.settings.image != blank %}
              <img
                src="{{ section.settings.image | image_url: width: 900 }}"
                alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
                loading="lazy"
              >
            {% else %}
              <img
                src="{{ 'fragrance-hero-luxury.png' | asset_url }}"
                alt=""
                width="1749"
                height="899"
                loading="lazy"
              >
            {% endif %}
          </div>
        {% endif %}

        <div class="dzire-footer__newsletter">
          <strong>{{ section.settings.newsletter_heading }}</strong>
          <span>{{ section.settings.newsletter_text }}</span>
          {% form 'customer', class: 'dzire-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="DzireFooterEmail-{{ section.id }}">Email</label>
            <input
              id="DzireFooterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="{{ section.settings.email_placeholder }}"
              required
            >
            <button type="submit">{{ section.settings.newsletter_button }}</button>
            {% if form.posted_successfully? %}
              <p class="dzire-footer__message" tabindex="-1" autofocus>{{ section.settings.success_message }}</p>
            {% elsif form.errors %}
              <p class="dzire-footer__message" tabindex="-1" autofocus>{{ form.errors | default_errors }}</p>
            {% endif %}
          {% endform %}
        </div>
      </div>

      <div>
        <div class="dzire-footer__columns">
          <div class="dzire-footer__column">
            <h3>{{ section.settings.shop_column_heading }}</h3>
            {% for block in section.blocks %}
              {% if block.type == 'link' and block.settings.column == 'shop' %}
                {% liquid
                  assign footer_link = block.settings.link
                  if footer_link == blank
                    assign footer_link = routes.all_products_collection_url
                  endif
                %}
                <a href="{{ footer_link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {% endif %}
            {% endfor %}
          </div>

          <div class="dzire-footer__column">
            <h3>{{ section.settings.help_column_heading }}</h3>
            {% for block in section.blocks %}
              {% if block.type == 'link' and block.settings.column == 'help' %}
                {% liquid
                  assign help_link = block.settings.link
                  if help_link == blank
                    assign help_link = routes.all_products_collection_url
                  endif
                %}
                <a href="{{ help_link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {% endif %}
            {% endfor %}
          </div>

          <div class="dzire-footer__column">
            <div class="dzire-footer__contact">
              <h3>{{ section.settings.contact_heading }}</h3>
              {% for block in section.blocks %}
                {% if block.type == 'contact' %}
                  <p {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
                {% endif %}
              {% endfor %}
            </div>

            <div class="dzire-footer__social">
              <h3>{{ section.settings.social_heading }}</h3>
              {% for block in section.blocks %}
                {% if block.type == 'social' %}
                  {% assign social_link = block.settings.link %}
                  {% if social_link != blank %}
                    <a href="{{ social_link }}" {{ block.shopify_attributes }} target="_blank" rel="noopener">
                      {{ block.settings.label }}
                    </a>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="dzire-footer__bottom">
      <span>{{ section.settings.bottom_text }}</span>
      <div class="dzire-footer__bottom-links">
        {% for block in section.blocks %}
          {% if block.type == 'link' and block.settings.column == 'legal' %}
            {% assign legal_link = block.settings.link %}
            {% if legal_link != blank %}
              <a href="{{ legal_link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Dzire footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
