{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

<div
  class="fragrance-home"
  style="
    --fh-section-bg: {{ section.settings.section_background }};
    --fh-card-bg: {{ section.settings.card_background }};
    --fh-card-text: {{ section.settings.card_text }};
    --fh-card-muted: {{ section.settings.card_muted_text }};
    --fh-card-border: {{ section.settings.card_border }};
  "
>
  <div class="fragrance-home__trust-row" aria-label="{{ section.settings.aria_label | escape }}">
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        <strong>{{ block.settings.title }}</strong>
        <span>{{ block.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Fragrance trust row",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Shopping benefits"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "card_muted_text",
      "label": "Card muted text",
      "default": "#6d675f"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5ded2"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Authentic selection"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Curated parfum, oud, musk, and daily-wear scents."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance trust row",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Authentic selection",
            "text": "Curated parfum, oud, musk, and daily-wear scents."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Gift-ready presentation",
            "text": "Elegant shopping paths for birthdays, events, and self-gifting."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Easy discovery",
            "text": "Shop by mood, concentration, occasion, and scent family."
          }
        }
      ]
    }
  ]
}
{% endschema %}
