{{ 'dzire-theme.css' | asset_url | stylesheet_tag }}

{% liquid
  assign home_link = section.settings.brand_link
  if home_link == blank
    assign home_link = routes.root_url
  endif

  assign announcement_link = section.settings.announcement_link
%}

<div
  class="dzire-shell"
  style="
    --dz-header-bg: {{ section.settings.header_background }};
    --dz-header-text: {{ section.settings.header_text }};
    --dz-header-muted: {{ section.settings.header_muted_text }};
    --dz-header-border: {{ section.settings.header_border }};
    --dz-announcement-bg: {{ section.settings.announcement_background }};
    --dz-announcement-text: {{ section.settings.announcement_text_color }};
    --dz-header-link-hover: {{ section.settings.link_hover_background }};
    --dz-header-button-bg: {{ section.settings.button_background }};
    --dz-header-button-text: {{ section.settings.button_text }};
    --dz-header-button-border: {{ section.settings.button_border }};
    --dz-cart-badge-bg: {{ section.settings.cart_badge_background }};
    --dz-cart-badge-text: {{ section.settings.cart_badge_text }};
  "
>
  <header class="dzire-header{% if section.settings.sticky_header %} dzire-header--sticky{% endif %}">
    {% if section.settings.announcement_text != blank %}
      <div class="dzire-header__announcement">
        {% if announcement_link != blank %}
          <a href="{{ announcement_link }}">{{ section.settings.announcement_text }}</a>
        {% else %}
          {{ section.settings.announcement_text }}
        {% endif %}
      </div>
    {% endif %}

    <div class="dzire-header__bar">
      <a class="dzire-header__brand" href="{{ home_link }}" aria-label="{{ section.settings.brand_name | escape }}">
        {% if section.settings.logo_image != blank %}
          <img
            class="dzire-header__logo"
            src="{{ section.settings.logo_image | image_url: height: 90 }}"
            alt="{{ section.settings.logo_image.alt | default: section.settings.brand_name | escape }}"
            width="{{ section.settings.logo_image.width }}"
            height="{{ section.settings.logo_image.height }}"
            loading="eager"
          >
        {% endif %}
        <span class="dzire-header__wordmark">
          <span class="dzire-header__name">{{ section.settings.brand_name }}</span>
          {% if section.settings.tagline != blank %}
            <span class="dzire-header__tagline">{{ section.settings.tagline }}</span>
          {% endif %}
        </span>
      </a>

      <nav class="dzire-header__nav" aria-label="Main navigation">
        {% for block in section.blocks %}
          {% if block.type == 'link' %}
            {% liquid
              assign nav_link = block.settings.link
              if nav_link == blank
                assign nav_link = routes.all_products_collection_url
              endif
            %}
            <a href="{{ nav_link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {% endif %}
        {% endfor %}
      </nav>

      <div class="dzire-header__actions">
        {% if section.settings.show_search %}
          <a class="dzire-header__icon-link dzire-header__search" href="{{ routes.search_url }}" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M10.8 18.1a7.3 7.3 0 1 1 0-14.6 7.3 7.3 0 0 1 0 14.6Zm5.2-2.1 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}

        {% if shop.customer_accounts_enabled and section.settings.show_account %}
          <a class="dzire-header__icon-link dzire-header__account" href="{{ routes.account_url }}" aria-label="Account">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 12.6a4.2 4.2 0 1 0 0-8.4 4.2 4.2 0 0 0 0 8.4Zm7.2 7.2a7.2 7.2 0 0 0-14.4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}

        <a class="dzire-header__icon-link" href="{{ routes.cart_url }}" aria-label="Cart">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M7.2 8.1h11.6l-1.2 10.4H8.4L7.2 8.1Zm3.1 0a3.7 3.7 0 0 1 7.4 0" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="dzire-header__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>

        <details class="dzire-header__drawer">
          <summary class="dzire-header__menu-button" aria-label="Open menu">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </summary>
          <div class="dzire-header__mobile-panel">
            {% for block in section.blocks %}
              {% if block.type == 'link' %}
                {% liquid
                  assign mobile_link = block.settings.link
                  if mobile_link == blank
                    assign mobile_link = routes.all_products_collection_url
                  endif
                %}
                <a href="{{ mobile_link }}">{{ block.settings.label }}</a>
              {% endif %}
            {% endfor %}
            {% if section.settings.show_search %}
              <a href="{{ routes.search_url }}">Search</a>
            {% endif %}
          </div>
        </details>
      </div>
    </div>
  </header>
</div>

<script>
  (() => {
    const headerGroup = document.getElementById('header-group');
    if (!headerGroup) return;
    const isSticky = {{ section.settings.sticky_header | json }};
    headerGroup.classList.toggle('dzire-header-group-sticky', isSticky);
    headerGroup.dataset.stickyState = isSticky ? 'active' : 'idle';

    const syncHeaderHeight = () => {
      document.body.style.setProperty('--header-height', `${headerGroup.offsetHeight}px`);
      document.body.style.setProperty('--header-group-height', `${headerGroup.offsetHeight}px`);
    };
    syncHeaderHeight();
    window.requestAnimationFrame(syncHeaderHeight);
  })();
</script>

{% schema %}
{
  "name": "Dzire header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#fffaf3"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Header text",
      "default": "#171615"
    },
    {
      "type": "color",
      "id": "header_muted_text",
      "label": "Header muted text",
      "default": "#6d675f"
    },
    {
      "type": "color",
      "id": "header_border",
      "label": "Header border",
      "default": "#d8cec1"
    },
    {
      "type": "color",
      "id": "announcement_background",
      "label": "Announcement background",
      "default": "#2f7066"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement text",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "link_hover_background",
      "label": "Menu hover background",
      "default": "#e9efe7"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Icon button background",
      "default": "#fffaf3"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Icon button text",
      "default": "#171615"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Icon button border",
      "default": "#d8cec1"
    },
    {
      "type": "color",
      "id": "cart_badge_background",
      "label": "Cart badge background",
      "default": "#8c4e68"
    },
    {
      "type": "color",
      "id": "cart_badge_text",
      "label": "Cart badge text",
