      "label": "Announcement link"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Dzire Fragrance"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Parfums and oud"
    },
    {
      "type": "url",
      "id": "brand_link",
      "label": "Brand link"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dzire header",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Shop",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "New arrivals",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Arabian perfume",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Gifts",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
