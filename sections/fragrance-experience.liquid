{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

<div
  class="fragrance-home"
  style="
    --fh-section-bg: {{ section.settings.section_background }};
    --fh-card-bg: {{ section.settings.card_background }};
    --fh-card-text: {{ section.settings.card_text }};
    --fh-card-muted: {{ section.settings.card_muted_text }};
    --fh-card-border: {{ section.settings.card_border }};
    --fh-accent: {{ section.settings.accent_color }};
  "
>
  <section class="fragrance-home__experience">
    <div class="fragrance-home__experience-intro">
      <p class="fragrance-home__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="fragrance-home__experience-grid">
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Fragrance experience",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The scent ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for choosing, wearing, and gifting with confidence."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "card_muted_text",
      "label": "Card muted text",
      "default": "#6d675f"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5ded2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent text",
      "default": "#b08a45"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Discover"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Browse by mood, notes, collection, or the moment you want the scent to own."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance experience",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Discover",
            "text": "Browse by mood, notes, collection, or the moment you want the scent to own."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Wear",
            "text": "Editorial product cards keep key details visible without slowing the shop."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Gift",
            "text": "Collection pathways make it simple to build a thoughtful cart for someone else."
          }
        }
      ]
    }
  ]
}
{% endschema %}
