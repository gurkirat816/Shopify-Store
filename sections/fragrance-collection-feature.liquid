{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

{% liquid
  assign selected_collection = section.settings.collection
  if selected_collection == blank
    assign selected_collection = collections.all
  endif

  assign section_link = section.settings.link
  if section_link == blank
    if selected_collection != blank
      assign section_link = selected_collection.url
    else
      assign section_link = routes.all_products_collection_url
    endif
  endif
%}

<div
  class="fragrance-home"
  style="
    --fh-section-bg: {{ section.settings.section_background }};
    --fh-secondary-bg: {{ section.settings.feature_background }};
    --fh-secondary-text: {{ section.settings.feature_text }};
    --fh-secondary-muted: {{ section.settings.feature_muted_text }};
    --fh-accent: {{ section.settings.accent_color }};
    --fh-button-dark-bg: {{ section.settings.button_background }};
    --fh-button-dark-text: {{ section.settings.button_text }};
    --fh-button-dark-border: {{ section.settings.button_border }};
    --fh-mini-card-bg: {{ section.settings.mini_card_background }};
    --fh-mini-card-border: {{ section.settings.mini_card_border }};
    --fh-mini-card-text: {{ section.settings.mini_card_text }};
    --fh-mini-card-muted: {{ section.settings.mini_card_muted_text }};
    --fh-product-image-bg: {{ section.settings.product_image_background }};
  "
>
  <section class="fragrance-home__secondary">
    <div class="fragrance-home__secondary-copy">
      <p class="fragrance-home__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a class="fragrance-home__button fragrance-home__button--dark" href="{{ section_link }}">
        {{ section.settings.button_label }}
      </a>
    </div>

    <div class="fragrance-home__mini-grid">
      {% if selected_collection != blank and selected_collection.products.size > 0 %}
        {% for product in selected_collection.products limit: 4 %}
          <a class="fragrance-home__mini-product" href="{{ product.url }}">
            {% if product.featured_image != blank %}
              <img
                src="{{ product.featured_image | image_url: width: 520 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                loading="lazy"
              >
            {% else %}
              {{ 'product-2' | placeholder_svg_tag: 'fragrance-home__product-placeholder' }}
            {% endif %}
            <span>{{ product.vendor | default: section.settings.fallback_vendor }}</span>
            <strong>{{ product.title }}</strong>
            <small>{{ product.price | money }}</small>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <article class="fragrance-home__mini-product">
            {{ 'product-2' | placeholder_svg_tag: 'fragrance-home__product-placeholder' }}
            <span>{{ section.settings.fallback_vendor }}</span>
            <strong>Discovery scent</strong>
            <small>{{ 6499 | money }}</small>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Fragrance collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Now available"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Arabian perfume"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore rich woods, amber trails, musks, spice, and statement scents with depth."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover collection"
    },
    {
      "type": "text",
      "id": "fallback_vendor",
      "label": "Fallback vendor label",
      "default": "Parfum"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "feature_background",
      "label": "Feature background",
      "default": "#14231f"
    },
    {
      "type": "color",
      "id": "feature_text",
      "label": "Feature text",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "feature_muted_text",
      "label": "Feature muted text",
      "default": "#d8d0c4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent text",
      "default": "#b08a45"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Button border",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "mini_card_background",
      "label": "Product card background",
      "default": "#25352f"
    },
    {
      "type": "color",
      "id": "mini_card_border",
      "label": "Product card border",
      "default": "#41524b"
    },
    {
      "type": "color",
      "id": "mini_card_text",
      "label": "Product card text",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "mini_card_muted_text",
      "label": "Product card muted text",
      "default": "#d8d0c4"
    },
    {
      "type": "color",
      "id": "product_image_background",
      "label": "Product image background",
      "default": "#f8f2e6"
    }
  ],
  "presets": [
    {
      "name": "Fragrance collection"
    }
  ]
}
{% endschema %}
