{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

<div
  class="fragrance-home fragrance-home--{{ section.settings.section_width | default: 'full-width' }} color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.use_color_scheme %} fragrance-home--use-color-scheme{% endif %} spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --fh-section-width: {% if section.settings.section_width == 'full-width' %}100%{% else %}1180px{% endif %};
    --fh-section-gutter: {% if section.settings.section_width == 'full-width' %}0px{% else %}32px{% endif %};
    --fh-nav-bg: {{ section.settings.nav_background }};
    --fh-nav-text: {{ section.settings.nav_text }};
    --fh-nav-border: {{ section.settings.nav_border }};
    --fh-nav-hover-bg: {{ section.settings.nav_hover_background }};
  "
>
  <nav class="fragrance-home__nav-strip" aria-label="{{ section.settings.aria_label | escape }}">
    {% for block in section.blocks %}
      {% liquid
        assign item_link = block.settings.link
        if item_link == blank
          assign item_link = routes.all_products_collection_url
        endif
      %}
      <a href="{{ item_link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
    {% endfor %}
  </nav>
</div>

{% schema %}
{
  "name": "Fragrance navigation",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "Use Horizon color scheme",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Popular fragrance categories"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "nav_background",
      "label": "Navigation background",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "nav_text",
      "label": "Navigation text",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "nav_border",
      "label": "Navigation border",
      "default": "#3a3935"
    },
    {
      "type": "color",
      "id": "nav_hover_background",
      "label": "Navigation hover background",
      "default": "#25352f"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All parfums"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance navigation",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "All parfums",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "New arrivals",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "For him",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "For her",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Unisex",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Arabian perfume",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
