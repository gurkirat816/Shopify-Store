{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

<div
  class="fragrance-home"
  style="
    --fh-nav-bg: {{ section.settings.nav_background }};
    --fh-nav-text: {{ section.settings.nav_text }};
    --fh-nav-border: {{ section.settings.nav_border }};
    --fh-nav-hover-bg: {{ section.settings.nav_hover_background }};
  "
>
  <nav class="fragrance-home__nav-strip" aria-label="{{ section.settings.aria_label | escape }}">
    {% for block in section.blocks %}
      {% liquid
        assign item_link = block.settings.link
        if item_link == blank
          assign item_link = routes.all_products_collection_url
        endif
      %}
      <a href="{{ item_link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
    {% endfor %}
  </nav>
</div>

{% schema %}
{
  "name": "Fragrance navigation",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Popular fragrance categories"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "nav_background",
      "label": "Navigation background",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "nav_text",
      "label": "Navigation text",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "nav_border",
      "label": "Navigation border",
      "default": "#3a3935"
    },
    {
      "type": "color",
      "id": "nav_hover_background",
      "label": "Navigation hover background",
      "default": "#25352f"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All parfums"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance navigation",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "All parfums",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "New arrivals",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "For him",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "For her",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Unisex",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Arabian perfume",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
