{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

<div
  class="fragrance-home fragrance-home--{{ section.settings.section_width | default: 'page-width' }} color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.use_color_scheme %} fragrance-home--use-color-scheme{% endif %} spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --fh-section-width: {% if section.settings.section_width == 'full-width' %}100%{% else %}1180px{% endif %};
    --fh-section-gutter: {% if section.settings.section_width == 'full-width' %}0px{% else %}32px{% endif %};
    --fh-section-bg: {{ section.settings.section_background }};
    --fh-card-bg: {{ section.settings.card_background }};
    --fh-card-text: {{ section.settings.card_text }};
    --fh-card-muted: {{ section.settings.card_muted_text }};
    --fh-card-border: {{ section.settings.card_border }};
    --fh-accent: {{ section.settings.accent_color }};
  "
>
  <section class="fragrance-home__why">
    <div class="fragrance-home__section-heading">
      <p class="fragrance-home__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="fragrance-home__reason-grid">
      {% for block in section.blocks %}
        {% liquid
          assign reason_number = forloop.index
          if reason_number < 10
            assign reason_number = reason_number | prepend: '0'
          endif
        %}
        <article {{ block.shopify_attributes }}>
          <span>{{ block.settings.number | default: reason_number }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Fragrance why shop",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "Use Horizon color scheme",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why shop with us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A refined fragrance store built for discovery."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "card_muted_text",
      "label": "Card muted text",
      "default": "#6d675f"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5ded2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent text",
      "default": "#b08a45"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Curated edits"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Collections are organized around scent mood, occasion, and daily wear."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance why shop",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "number": "01",
            "title": "Curated edits",
            "text": "Collections are organized around scent mood, occasion, and daily wear."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "02",
            "title": "Long-wear focus",
            "text": "Product pages give each scent room to feel premium and considered."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "03",
            "title": "Bundle friendly",
            "text": "The layout keeps discovery sets, bundles, and gift shopping easy to scan."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "04",
            "title": "Elegant gifting",
            "text": "A polished visual system gives every product a gift-ready presence."
          }
        }
      ]
    }
  ]
}
{% endschema %}
