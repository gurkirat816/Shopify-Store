{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

<div
  class="fragrance-home"
  style="
    --fh-section-bg: {{ section.settings.section_background }};
    --fh-newsletter-bg: {{ section.settings.section_background }};
    --fh-newsletter-text: {{ section.settings.text_color }};
    --fh-newsletter-muted: {{ section.settings.muted_text }};
    --fh-accent: {{ section.settings.accent_color }};
    --fh-newsletter-input-bg: {{ section.settings.input_background }};
    --fh-newsletter-input-text: {{ section.settings.input_text }};
    --fh-newsletter-input-border: {{ section.settings.input_border }};
    --fh-newsletter-button-bg: {{ section.settings.button_background }};
    --fh-newsletter-button-text: {{ section.settings.button_text }};
  "
>
  <section class="fragrance-home__newsletter">
    <div>
      <p class="fragrance-home__eyebrow">{{ section.settings.eyebrow | default: shop.name }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {% form 'customer', class: 'fragrance-home__newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="FragranceNewsletter-{{ section.id }}">Email</label>
      <input
        id="FragranceNewsletter-{{ section.id }}"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        placeholder="{{ section.settings.placeholder }}"
        required
      >
      <button type="submit">{{ section.settings.button_label }}</button>
      {% if form.posted_successfully? %}
        <p class="fragrance-home__form-message" tabindex="-1" autofocus>{{ section.settings.success_message }}</p>
      {% elsif form.errors %}
        <p class="fragrance-home__form-message" tabindex="-1" autofocus>{{ form.errors | default_errors }}</p>
      {% endif %}
    {% endform %}
  </section>
</div>

{% schema %}
{
  "name": "Fragrance newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Dzire Fragrance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the world of scent"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "New arrivals, limited edits, and fragrance stories delivered to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "muted_text",
      "label": "Muted text",
      "default": "#d8d0c4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow",
      "default": "#b08a45"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "input_text",
      "label": "Input text",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "Input border",
      "default": "#3a3935"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#b08a45"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#fffdf8"
    }
  ],
  "presets": [
    {
      "name": "Fragrance newsletter"
    }
  ]
}
{% endschema %}
