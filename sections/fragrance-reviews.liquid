{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

<div
  class="fragrance-home"
  style="
    --fh-section-bg: {{ section.settings.section_background }};
    --fh-card-bg: {{ section.settings.card_background }};
    --fh-card-text: {{ section.settings.card_text }};
    --fh-card-muted: {{ section.settings.card_muted_text }};
    --fh-card-border: {{ section.settings.card_border }};
    --fh-accent: {{ section.settings.accent_color }};
  "
>
  <section class="fragrance-home__reviews">
    <div class="fragrance-home__reviews-heading">
      <p class="fragrance-home__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="fragrance-home__review-grid">
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}>
          <span>{{ block.settings.label }}</span>
          <p>{{ block.settings.quote }}</p>
          <strong>{{ block.settings.name }}</strong>
        </article>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Fragrance reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed to make buying perfume feel confident."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "card_muted_text",
      "label": "Card muted text",
      "default": "#6d675f"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5ded2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent text",
      "default": "#b08a45"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "4.9 / 5"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The store feels premium and makes it easy to choose a gift without guessing."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Gift shopper"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "label": "4.9 / 5",
            "quote": "The store feels premium and makes it easy to choose a gift without guessing.",
            "name": "Gift shopper"
          }
        },
        {
          "type": "review",
          "settings": {
            "label": "Long-wear picks",
            "quote": "I like that the collections separate everyday scents from deeper evening fragrances.",
            "name": "Daily fragrance wearer"
          }
        },
        {
          "type": "review",
          "settings": {
            "label": "Discovery first",
            "quote": "The layout helps people browse by mood, not just by product name.",
            "name": "New customer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
