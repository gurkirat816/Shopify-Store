{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

<div
  class="fragrance-home fragrance-home--{{ section.settings.section_width | default: 'page-width' }} color-{{ section.settings.color_scheme | default: 'scheme-1' }}{% if section.settings.use_color_scheme %} fragrance-home--use-color-scheme{% endif %} spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --fh-section-width: {% if section.settings.section_width == 'full-width' %}100%{% else %}1180px{% endif %};
    --fh-section-gutter: {% if section.settings.section_width == 'full-width' %}0px{% else %}32px{% endif %};
    --fh-section-bg: {{ section.settings.section_background }};
    --fh-card-bg: {{ section.settings.card_background }};
    --fh-card-text: {{ section.settings.card_text }};
    --fh-card-muted: {{ section.settings.card_muted_text }};
    --fh-card-border: {{ section.settings.card_border }};
    --fh-accent: {{ section.settings.accent_color }};
  "
>
  <section class="fragrance-home__moods" aria-label="{{ section.settings.aria_label | escape }}">
    {% for block in section.blocks %}
      {% liquid
        assign mood_link = block.settings.link
        if mood_link == blank
          assign mood_link = routes.all_products_collection_url
        endif
      %}
      <a
        href="{{ mood_link }}"
        class="fragrance-home__mood-card fragrance-home__mood-card--{{ block.settings.style }}"
        {{ block.shopify_attributes }}
      >
        <span>{{ block.settings.eyebrow }}</span>
        <strong>{{ block.settings.title }}</strong>
        <small>{{ block.settings.text }}</small>
      </a>
    {% endfor %}
  </section>
</div>

{% schema %}
{
  "name": "Fragrance mood cards",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "Use Horizon color scheme",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Shop by mood"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Default card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "default": "#11100d"
    },
    {
      "type": "color",
      "id": "card_muted_text",
      "label": "Card muted text",
      "default": "#6d675f"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5ded2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent text",
      "default": "#b08a45"
    }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Card style",
          "options": [
            {
              "value": "fresh",
              "label": "Fresh"
            },
            {
              "value": "floral",
              "label": "Floral"
            },
            {
              "value": "oud",
              "label": "Oud"
            },
            {
              "value": "night",
              "label": "Evening"
            }
          ],
          "default": "fresh"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Fresh"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean daily signatures"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Bright citrus, airy musk, soft florals"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance mood cards",
      "blocks": [
        {
          "type": "mood",
          "settings": {
            "style": "fresh",
            "eyebrow": "Fresh",
            "title": "Clean daily signatures",
            "text": "Bright citrus, airy musk, soft florals",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "mood",
          "settings": {
            "style": "floral",
            "eyebrow": "Floral",
            "title": "Romantic and polished",
            "text": "Rose, jasmine, powder, amber",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "mood",
          "settings": {
            "style": "oud",
            "eyebrow": "Oud",
            "title": "Warm statement trails",
            "text": "Woods, spice, resin, smoke",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "mood",
          "settings": {
            "style": "night",
            "eyebrow": "Evening",
            "title": "Deep after-dark scents",
            "text": "Vanilla, leather, amber, musk",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
