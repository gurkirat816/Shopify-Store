{{ 'fragrance-home.css' | asset_url | stylesheet_tag }}

{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif

  assign collection_link = section.settings.link
  if collection_link == blank
    if featured_collection != blank
      assign collection_link = featured_collection.url
    else
      assign collection_link = routes.all_products_collection_url
    endif
  endif
%}

<div class="fragrance-home">
  <section class="fragrance-home__collection">
    <div class="fragrance-home__collection-heading">
      <div>
        <p class="fragrance-home__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <a class="fragrance-home__text-link" href="{{ collection_link }}">{{ section.settings.link_label }}</a>
    </div>

    <div class="fragrance-home__product-grid">
      {% if featured_collection != blank and featured_collection.products.size > 0 %}
        {% for product in featured_collection.products limit: section.settings.product_limit %}
          {% liquid
            assign product_number = forloop.index
            if product_number < 10
              assign product_number = product_number | prepend: '0'
            endif
            assign product_description = product.description | strip_html | truncate: 100
            if product_description == blank
              assign product_description = section.settings.default_product_note
            endif
          %}
          <a class="fragrance-home__product-card" href="{{ product.url }}">
            <span class="fragrance-home__product-number">{{ product_number }}</span>
            {% if section.settings.show_badges %}
              {% if forloop.index == 1 %}
                <span class="fragrance-home__product-badge">{{ section.settings.first_badge }}</span>
              {% elsif forloop.index == 2 %}
                <span class="fragrance-home__product-badge">{{ section.settings.second_badge }}</span>
              {% endif %}
            {% endif %}
            <div class="fragrance-home__product-media">
              {% if product.featured_image != blank %}
                <img
                  src="{{ product.featured_image | image_url: width: 720 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'fragrance-home__product-placeholder' }}
              {% endif %}
            </div>
            <div class="fragrance-home__product-copy">
              <p>{{ product.vendor | default: section.settings.fallback_vendor }}</p>
              <h3>{{ product.title }}</h3>
              <span>{{ product_description }}</span>
              <div class="fragrance-home__product-footer">
                <strong>{{ product.price | money }}</strong>
                <em>{{ section.settings.product_link_label }}</em>
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..6) %}
          {% liquid
            assign placeholder_number = i
            if placeholder_number < 10
              assign placeholder_number = placeholder_number | prepend: '0'
            endif
          %}
          <article class="fragrance-home__product-card">
            <span class="fragrance-home__product-number">{{ placeholder_number }}</span>
            <div class="fragrance-home__product-media">
              {{ 'product-1' | placeholder_svg_tag: 'fragrance-home__product-placeholder' }}
            </div>
            <div class="fragrance-home__product-copy">
              <p>{{ section.settings.fallback_vendor }}</p>
              <h3>Signature scent</h3>
              <span>{{ section.settings.default_product_note }}</span>
              <div class="fragrance-home__product-footer">
                <strong>{{ 6499 | money }}</strong>
                <em>{{ section.settings.product_link_label }}</em>
              </div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Fragrance product grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New fragrances"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh arrivals. Signature energy."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Heading link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Heading link label",
      "default": "View collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Product count",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show first two product badges",
      "default": true
    },
    {
      "type": "text",
      "id": "first_badge",
      "label": "First badge",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "second_badge",
      "label": "Second badge",
      "default": "New"
    },
    {
      "type": "text",
      "id": "fallback_vendor",
      "label": "Fallback vendor label",
      "default": "Parfum"
    },
    {
      "type": "textarea",
      "id": "default_product_note",
      "label": "Fallback product note",
      "default": "A polished scent profile designed for daily rituals and evening moments."
    },
    {
      "type": "text",
      "id": "product_link_label",
      "label": "Product link label",
      "default": "View scent"
    }
  ],
  "presets": [
    {
      "name": "Fragrance product grid"
    }
  ]
}
{% endschema %}
